<Application x:Class="RingInfo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RingInfo.App.ViewModels"
             xmlns:controls="clr-namespace:RingInfo.App.Controls"
             xmlns:converters="clr-namespace:RingInfo.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 先頭の色辞書は ThemeManager がシステムのテーマに合わせて差し替える -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:ScoreLevelToBrushConverter x:Key="ScoreLevelToBrush" />

            <!-- 数値タイル -->
            <DataTemplate DataType="{x:Type vm:MetricTile}">
                <Border Margin="0,0,12,12" Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding Value, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><Run
                                 Text="{Binding UnitText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- スコアカード（円形ゲージ + 評価ラベル） -->
            <DataTemplate DataType="{x:Type vm:ScoreCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="96">
                        <controls:ScoreGauge Value="{Binding Score}" Thickness="8"
                                             Fill="{Binding Level, Converter={StaticResource ScoreLevelToBrush}}"
                                             Track="{DynamicResource HairlineBrush}" />
                        <TextBlock Text="{Binding ScoreText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                            <Ellipse Width="8" Height="8" Fill="{Binding Level, Converter={StaticResource ScoreLevelToBrush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LevelLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding DayText}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- スコアの寄与要素 -->
            <Style x:Key="ContributorBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="6" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource HairlineBrush}" />
                                <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate DataType="{x:Type vm:ContributorItem}">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource ContributorBar}" Value="{Binding BarValue, Mode=OneWay}"
                                 Foreground="{Binding Level, Converter={StaticResource ScoreLevelToBrush}}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <!-- 色見本付きの内訳（グラフの凡例を兼ねる） -->
            <DataTemplate DataType="{x:Type vm:BreakdownItem}">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Swatch}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                    <TextBlock Grid.Column="3" Text="{Binding Share}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <!-- ラベルと値 -->
            <DataTemplate DataType="{x:Type vm:InfoRow}">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>

            <!-- タイルを均等な幅で並べる（狭いときは列数を減らして折り返す） -->
            <ItemsPanelTemplate x:Key="TileGrid4">
                <controls:AdaptiveUniformGrid MaxColumns="4" MinItemWidth="170" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="TileGrid6">
                <controls:AdaptiveUniformGrid MaxColumns="6" MinItemWidth="150" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
