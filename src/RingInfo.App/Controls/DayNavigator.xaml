<UserControl x:Class="RingInfo.App.Controls.DayNavigator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RingInfo.App.Controls">
    <!-- DataContext: PreviousDayCommand / NextDayCommand / SelectedDayText / CalendarDate / CalendarMin / CalendarMax を持つページ -->
    <UserControl.Resources>
        <Style x:Key="DateButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="10,4" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AxisBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousDayCommand}" ToolTip="前の日" />
        <Grid>
            <Button x:Name="DateButton" Style="{StaticResource DateButton}" Click="OnDateButtonClick" ToolTip="カレンダーから日付を選ぶ" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedDayText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="130" TextAlignment="Center" />
                    <TextBlock Text="&#xE787;" Style="{StaticResource IconText}" FontSize="14" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Button>
            <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=DateButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <local:MonthCalendar x:Name="Calendar" PreviewKeyDown="OnCalendarKeyDown"
                                     SelectedDate="{Binding CalendarDate, Mode=TwoWay}"
                                     MinDate="{Binding CalendarMin}"
                                     MaxDate="{Binding CalendarMax}"
                                     DateSelected="OnDateSelected" />
            </Popup>
        </Grid>
        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextDayCommand}" ToolTip="次の日" />
    </StackPanel>
</UserControl>
