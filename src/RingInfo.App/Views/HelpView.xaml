<UserControl x:Class="RingInfo.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RingInfo.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HelpPageViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,8,20,12">
        <StackPanel x:Name="PageContent" Background="{DynamicResource PageBrush}" MaxWidth="980" HorizontalAlignment="Left">

            <!-- アプリ情報 -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="/Assets/RingInfo.png" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel>
                        <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,2,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="バージョン" Style="{StaticResource CaptionText}" Margin="0,3" />
                            <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,3" />
                            <TextBlock Grid.Row="1" Text="製作者" Style="{StaticResource CaptionText}" Margin="0,3" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                <Button Style="{StaticResource LinkButton}" Content="GitHub" Command="{Binding OpenAuthorPageCommand}" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="著作権" Style="{StaticResource CaptionText}" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Copyright}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,3" />
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 使い方 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="使い方" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Tips}" />
                </StackPanel>
            </Border>

            <!-- 商標・注意事項 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="商標・注意事項" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Trademark}" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                               Text="本アプリは Oura Health Oy が提供・承認した公式のアプリではありません。" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="{Binding MembershipNotice}" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                               Text="表示される内容は参考情報であり、医療上の診断・治療を目的としたものではありません。" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                               Text="取得したデータはこの PC の画面表示にのみ使い、製作者や第三者に送信することはありません。" />
                </StackPanel>
            </Border>

            <!-- ライブラリ・ファイル -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="使用しているライブラリ" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="ライセンス名を押すと全文を表示します。" />
                    <ItemsControl ItemsSource="{Binding Libraries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LibraryLicense}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="{Binding LicenseName}" VerticalAlignment="Center"
                                            HorizontalAlignment="Left" ToolTip="ライセンスの全文を表示"
                                            Command="{Binding DataContext.ShowLicenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ライセンスの全文 -->
                    <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource TileBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Visibility="{Binding IsLicenseVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="閉じる" Command="{Binding CloseLicenseCommand}" Padding="12,4" />
                                <TextBlock Text="{Binding LicenseTitle}" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBox Text="{Binding LicenseText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="320"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Yu Gothic UI" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Hairline}" />
                    <TextBlock Text="ファイルの場所" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                        <Run Text="設定: " /><Run Text="{Binding SettingsFilePath, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="エラーの記録: " /><Run Text="{Binding ErrorLogPath, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
