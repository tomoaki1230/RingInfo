<?xml version="1.0" encoding="utf-8"?>
<!--
  ランタイム同梱版（.NET のインストール不要）の発行設定。
  使い方: dotnet publish src/RingInfo.App/RingInfo.App.csproj -c Release -p:PublishProfile=SelfContained
  出力: dist/self-contained/RingInfo.exe（単一ファイル・圧縮あり、約 68 MB）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF のネイティブ DLL も exe に含める（初回起動時に一時フォルダーへ展開される） -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 圧縮してサイズを約 148 MB → 約 68 MB に減らす（起動時に展開するため起動がわずかに遅くなる） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\self-contained\</PublishDir>
  </PropertyGroup>
</Project>
